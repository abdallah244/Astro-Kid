# Copy to `.env` next to docker-compose.yml and fill in. Never commit the real `.env`.

# The public address of the site, with https and no trailing slash
SITE_URL=https://your-domain.com

# Port on 127.0.0.1 that your VPS reverse proxy forwards to (pick one that is free)
WEB_PORT=8090

# Database password (long and random):  openssl rand -base64 32
POSTGRES_PASSWORD=

# Cookie signing secret (at least 32 characters):  openssl rand -hex 32
COOKIE_SECRET=

# Google Cloud Console > APIs & Services > Credentials > OAuth client (Web application)
# Authorized redirect URI:  ${SITE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SESSION_DAYS=30

# Optional: a Telegram message when someone signs up (no personal data is sent)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
