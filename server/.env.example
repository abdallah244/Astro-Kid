NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://astrokid_app:CHANGE_ME@127.0.0.1:5432/astrokid
SITE_ORIGIN=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
RELEASES_DIR=./releases
SESSION_DAYS=30
# Docker: listen on all interfaces inside the container (default 127.0.0.1)
HOST=127.0.0.1
# Optional: Telegram ping when someone signs up (no personal data in the message)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
